# BenchDash — Environment Configuration
#
# Copy this file to .env and edit as needed.

# --- Ollama ---
# Point to your Ollama instance (use host.docker.internal for Docker Desktop)
OLLAMA_HOST=<set-value>

# --- Dashboard ---
DASHBOARD_PORT=8081
DASHBOARD_HOST=<set-value>

# --- Benchmark ---
# Set to 1 to skip image/audio/video tests
BENCH_SKIP_MEDIA=0

# --- Notifications (optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
